      ],
      "id": "70000000-0000-4000-8000-000000000017",
      "name": "Fan In — AI Workboard"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const columns = [\"id\",\"received_at\",\"requester\",\"channel\",\"text\",\"wave\",\"workstream\",\"priority\",\"summary\",\"next_action\",\"branch_policy\",\"policy_value\",\"sla_hours\",\"target_by\"];\nconst rows = $input.all().map((item) => item.json).sort((a, b) => String(a.id).localeCompare(String(b.id)));\nreturn rows.map((row) => ({ json: Object.fromEntries(columns.map((column) => [column, row[column] ?? ''])) }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
