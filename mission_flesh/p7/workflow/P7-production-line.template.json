      "name": "Write AI_workboard.csv"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map((item) => item.json);\nconst count = (field, value) => rows.filter((row) => String(row[field]) === String(value)).length;\nconst operations = rows.filter((row) => row.workstream === 'OPERATIONS');\nreturn [{ json: {\n  workflow: 'P7 Spreadsheet Control Line',\n  generated_at: new Date().toISOString(),\n  sheet_name: 'AI Workboard',\n  record_count: rows.length,\n  workstream_counts: {\n    OPERATIONS: count('workstream', 'OPERATIONS'),\n    FINANCE: count('workstream', 'FINANCE'),\n    PEOPLE: count('workstream', 'PEOPLE'),\n    TECHNOLOGY: count('workstream', 'TECHNOLOGY')\n  },\n  priority_counts: { P1: count('priority', 'P1'), P2: count('priority', 'P2'), P3: count('priority', 'P3') },\n  wave_counts: { '1': count('wave', 1), '2': count('wave', 2) },\n  operations_sla_hours: operations.length ? Number(operations[0].sla_hours) : 0,\n  products: ['workboard.xlsx', 'AI_workboard.csv', 'run_receipt.json']\n}}];"
      },
