{"reference_implementation":"registry.js — focused replacements; keep all unshown B0–P8 records and helpers unchanged.\n\n/* Add before REGISTRY. Every phase contains required checks only. */\nvar PREWORK_PHASES = [\n  { code: \"begin\", label: \"Before you begin\", ids: [\"i-time\", \"i-log\", \"i-keys\", \"i-shape\"] },\n  { code: \"baseline\", label: \"Baseline machine\", ids: [\"b-win11\", \"b-arm\", \"b-disk\", \"b-admin\"] },\n  { code: \"powershell\", label: \"Terminal and PowerShell\", ids: [\"ps-open\", \"ps-version\", \"ps-policy\"] },\n  { code: \"winget\", label: \"winget\", ids: [\"wg-check\", \"wg-agree\"] },\n  { code: \"git\", label: \"Git for Windows\", ids: [\"git-install\", \"git-restart\", \"git-verify\"] },\n  { code: \"runtimes\", label: \"Node.js and Python\", ids: [\"np-node\", \"np-python\", \"np-restart\", \"np-verify\", \"np-stub\"] },\n  { code: \"keys\", label: \"Your three API keys\", ids: [\"k-read\", \"k-openai\", \"k-xai\", \"k-anthropic\", \"k-models\", \"k-verify\"] },\n  { code: \"smoke\", label: \"Your smoke folder\", ids: [\"sf-make\", \"sf-why\"] },\n  { code: \"codex\", label: \"Codex\", ids: [\"cx-install\", \"cx-signin\", \"cx-status\", \"cx-lock\", \"cx-project\", \"cx-sandbox\", \"cx-write\", \"cx-limits\"] },\n  { code: \"opencode\", label: \"OpenCode\", ids: [\"oc-why\", \"oc-version\", \"oc-install\", \"oc-verify\", \"oc-models\", \"oc-independent\", \"oc-write\"] },\n  { code: \"pi\", label: \"Pi\", ids: [\"pi-why\", \"pi-install\", \"pi-verify\", \"pi-write\", \"pi-bash\"] },\n  { code: \"goose\", label: \"goose\", ids: [\"gs-what\", \"gs-nowinget\", \"gs-keyring\", \"gs-provider\", \"gs-install\", \"gs-path\", \"gs-verify\", \"gs-write\"] },\n  { code: \"obsidian\", label: \"Obsidian\", ids: [\"ob-install\", \"ob-vault\"] },\n  { code: \"n8n\", label: \"n8n\", ids: [\"n8n-node\", \"n8n-install\", \"n8n-start\", \"n8n-owner\", \"n8n-stop\"] },\n  { code: \"repo\", label: \"Course repo and operator pack\", ids: [\"rp-get\", \"rp-operator\", \"rp-site\", \"rp-gitignore\"] },\n  { code: \"pack\", label: \"Pack for Monday\", ids: [\"g-four\", \"g-log\", \"g-pack\"] }\n];\n\nvar PREWORK_REQUIRED_IDS = [];\nfor (var pi = 0; pi < PREWORK_PHASES.length; pi++) {\n  PREWORK_PHASES[pi].anchor = \"ahb-prework-install-\" + PREWORK_PHASES[pi].ids[0];\n  PREWORK_REQUIRED_IDS = PREWORK_REQUIRED_IDS.concat(PREWORK_PHASES[pi].ids);\n}\nvar PREWORK_CONDITIONAL_IDS = [\"wg-fix\"];\nvar PREWORK_RECOVERY_IDS = [\n  \"r-notfound\", \"r-window\", \"r-scripts\", \"r-auth\",\n  \"r-store\", \"r-noclaim\", \"r-stuck\"\n];\n\n/* In the existing INSTALL record, replace only ids and add the metadata fields.\n   Keep key, stretchIds, URL, and all other fields unchanged. */\nids: PREWORK_REQUIRED_IDS.slice(),\nconditionalIds: PREWORK_CONDITIONAL_IDS.slice(),\nrecoveryIds: PREWORK_RECOVERY_IDS.slice(),\n\n/* Add immediately after block(). */\nvar COURSE_CODES = [\"B0\", \"P1\", \"P2\", \"P3\", \"P4\", \"P5\", \"P6\", \"P7\", \"P8\"];\nvar COURSE_BLOCKS = [];\nfor (var ci = 0; ci < COURSE_CODES.length; ci++) {\n  var courseBlock = block(COURSE_CODES[ci]);\n  if (courseBlock) COURSE_BLOCKS.push(courseBlock);\n}\nvar PREWORK = {\n  code: \"PREWORK\", name: \"Pre-work\", title: \"Pre-work\",\n  day: \"Before Monday\", slot: \"pre\", key: null, ids: [], stretchIds: [],\n  url: \"prework.html\", meta: \"Prerequisite\"\n};\nvar COURSE_PATH = [PREWORK].concat(COURSE_BLOCKS);\nvar TOTAL_MODULES = COURSE_BLOCKS.length;\n\nfunction firstIncompletePreworkPhase(state) {\n  var install = block(\"INSTALL\");\n  if (!install) return null;\n  state = state || readState(install.key);\n  for (var i = 0; i < PREWORK_PHASES.length; i++) {\n    var phase = PREWORK_PHASES[i];\n    for (var j = 0; j < phase.ids.length; j++) {\n      if (state[phase.ids[j]] !== true) return phase;\n    }\n  }\n  return null;\n}\n\n/* Replace currentBlock, blockNumber, and the export. */\nfunction currentBlock() {\n  var install = block(\"INSTALL\");\n  if (install && !isComplete(install)) return install;\n  for (var i = 0; i < COURSE_BLOCKS.length; i++) {\n    if (!isComplete(COURSE_BLOCKS[i])) return COURSE_BLOCKS[i];\n  }\n  return COURSE_BLOCKS.length ? COURSE_BLOCKS[COURSE_BLOCKS.length - 1] : install;\n}\nfunction moduleNumber(code) {\n  for (var i = 0; i < COURSE_BLOCKS.length; i++) {\n    if (COURSE_BLOCKS[i].code === code) return i + 1;\n  }\n  return 0;\n}\nfunction blockNumber(code) { return moduleNumber(code); }\n\nwindow.AHB = {\n  REGISTRY: REGISTRY, JOURNEY: JOURNEY, DAY_NAV: DAY_NAV,\n  PREWORK: PREWORK, PREWORK_PHASES: PREWORK_PHASES,\n  COURSE_BLOCKS: COURSE_BLOCKS, COURSE_PATH: COURSE_PATH,\n  TOTAL_MODULES: TOTAL_MODULES,\n  TOTAL_BLOCKS: TOTAL_MODULES,\n  block: block, readState: readState, countDone: countDone,\n  countStretchDone: countStretchDone, isComplete: isComplete,\n  currentBlock: currentBlock,\n  firstIncompletePreworkPhase: firstIncompletePreworkPhase,\n  moduleNumber: moduleNumber, blockNumber: blockNumber\n};\n\nshell.js — focused replacements; keep dropdown wiring, plates, dashboard, storage writes, and copy behavior unchanged.\n\n/* Delete RESOURCE_SHELVES and navGroupFor. Replace buildNav. */\nfunction buildNav(prefix, current) {\n  var cur = AHB.currentBlock();\n  var preworkActive = current === \"prework\" || current === \"keys\" ||\n    current === \"prework-install\";\n\n  function topLink(href, label, active) {\n    return '<a href=\"' + href + '\"' +\n      (active ? ' aria-current=\"page\"' : \"\") + \">\" + label + \"</a>\";\n  }\n\n  var html = topLink(prefix + \"/prework.html\", \"Pre-work\", preworkActive);\n  AHB.DAY_NAV.forEach(function (day, di) {\n    var dayActive = day.codes.some(function (code) {\n      return current === \"block-\" + code.toLowerCase();\n    });\n    html += '<div class=\"nav-drop' + (dayActive ? \" is-active\" : \"\") + '\" data-nav-drop>';\n    html += '<button type=\"button\" class=\"nav-drop-btn\" aria-expanded=\"false\"' +\n      ' aria-controls=\"nav-day-' + di + '\">' + day.label +\n      '<span class=\"caret\" aria-hidden=\"true\"></span></button>';\n    html += '<div class=\"nav-drop-panel nav-drop-blocks\" id=\"nav-day-' + di + '\"' +\n      ' role=\"group\" aria-label=\"' + day.label + ' modules\">';\n    day.codes.forEach(function (code) {\n      var b = AHB.block(code);\n      var st = statusOf(b, cur);\n      var isHere = current === \"block-\" + code.toLowerCase();\n      html += '<a class=\"nav-drop-item' + (st === \"done\" ? \" is-done\" : \"\") + '\"' +\n        ' href=\"' + prefix + \"/\" + b.url + '\"' +\n        (isHere ? ' aria-current=\"page\"' : \"\") + \">\";\n      html += dotHtml(st);\n      html += '<span class=\"nav-drop-name\"><strong>' + b.code + \"</strong> · \" +\n        b.name + \"</span>\";\n      html += '<span class=\"nav-drop-slot\">' + b.slot + \"</span></a>\";\n    });\n    html += \"</div></div>\";\n  });\n  return html;\n}\n\n/* Replace neighbors. INSTALL gets an explicit hub back-link; modules traverse COURSE_PATH. */\nfunction neighbors(code) {\n  if (code === \"INSTALL\") {\n    return { prev: AHB.PREWORK, next: AHB.COURSE_BLOCKS[0] || null };\n  }\n  if (code === \"KEYS\") code = \"PREWORK\";\n  var path = AHB.COURSE_PATH;\n  var index = -1;\n  for (var i = 0; i < path.length; i++) {\n    if (path[i].code === code) { index = i; break; }\n  }\n  if (index < 0) return { prev: null, next: null };\n  return {\n    prev: index > 0 ? path[index - 1] : null,\n    next: index < path.length - 1 ? path[index + 1] : null\n  };\n}\n\n/* Add this helper and replace the old Block-number label in renderContextStrips. */\nfunction contextLabel(b) {\n  var n = AHB.moduleNumber(b.code);\n  return n\n    ? dayLabel(b) + \" · Module \" + n + \" of \" + AHB.TOTAL_MODULES\n    : dayLabel(b) + \" · Pre-work prerequisite\";\n}\n// inside renderContextStrips:\nvar label = contextLabel(b);\n\n/* renderPlates needs no other change: it already consumes neighbors(). */\n\n/* In updateProgressOutputs section counts, replace the isOptional test. */\nvar checkId = box.getAttribute(\"data-check-id\");\nif (b.ids.indexOf(checkId) === -1) return;\n\n/* In renderPreworkHub, replace declarations through its CTA block. */\nvar install = AHB.block(\"INSTALL\");\nif (!install) return;\nvar state = AHB.readState(install.key);\nvar done = AHB.countDone(install);\nvar total = install.ids.length;\nvar pct = total ? Math.round((done / total) * 100) : 0;\nvar complete = AHB.isComplete(install);\nvar started = done > 0;\nvar keysRead = state[\"k-read\"] === true;\nvar phase = AHB.firstIncompletePreworkPhase(state);\nvar resumeHref = prefix + \"/\" + install.url;\nif (phase && phase.anchor) resumeHref += \"#\" + String(phase.anchor).replace(/^#/, \"\");\n\nsetText(\"[data-hub-headline]\", complete\n  ? \"Pre-work complete — see you Monday\"\n  : started ? \"Install in progress\" : \"Not started yet\");\nsetText(\"[data-hub-line]\", done + \" / \" + total + \" install steps · \" + pct + \"%\");\nvar bar = document.querySelector(\"[data-hub-bar]\");\nif (bar) bar.style.width = pct + \"%\";\nvar cta = document.querySelector(\"[data-hub-cta]\");\nif (cta) {\n  if (complete) {\n    cta.textContent = \"Review the checklist\";\n    cta.setAttribute(\"href\", prefix + \"/\" + install.url);\n  } else if (started) {\n    cta.textContent = \"Continue the install checklist\";\n    cta.setAttribute(\"href\", resumeHref);\n  } else {\n    cta.textContent = \"Start with Your API keys\";\n    cta.setAttribute(\"href\", prefix + \"/keys.html\");\n  }\n}\n/* Keep the existing setStage helper/calls below this block; they now use the\n   exact k-read state through keysRead. */","approach_summary":"Keep the broad registry for storage and dashboard compatibility, but derive a nine-entry COURSE_BLOCKS sequence and a separate Pre-work route. Required pre-work progress comes from an explicit phase model, while shell navigation and numbering consume only the course sequence.","edge_cases_handled":["Malformed, missing, or non-object localStorage JSON continues to read as an empty state.","Saved wg-fix, r-*, optional, and unknown properties are neither migrated nor deleted; form handlers still load and save them.","Conditional, recovery, and stretch checks do not affect required totals, section totals, completion, or current-module selection.","Partial progress resumes at the earliest incomplete required phase; a missing fragment target harmlessly opens the checklist without a JavaScript lookup.","INSTALL is labeled as a prerequisite, B0–P8 are Module 1 of 9 through Module 9 of 9, and completed course state remains on P8.","B0 points back to site/prework.html, P8 has no next module, INSTALL can point back to the hub, and unknown sequence codes return null neighbors.","Missing hub, CTA, progress bar, stage card, or INSTALL registry entry is guarded."],"alternative_approach":"A cleaner but more invasive option is to split REGISTRY into separate PREWORK_ITEMS and COURSE_BLOCKS source arrays, then expose a concatenated compatibility REGISTRY. The derived-sequence approach above has lower regression risk.","notes":"The Starzl brand links already live outside the generated nav, so removing the generated Home item leaves the brand as Home. Existing storage keys and checkbox IDs remain unchanged, and no HTML change is required. This is a read-only reference seed; it was not applied or tested."}