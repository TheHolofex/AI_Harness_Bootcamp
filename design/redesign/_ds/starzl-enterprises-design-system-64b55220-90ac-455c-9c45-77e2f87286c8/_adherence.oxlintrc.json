{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/sent/data/**",
              "components/sent/identity/**",
              "components/sent/primitives/**",
              "components/sent/rows/**",
              "components/site/cards/**",
              "components/site/chrome/**",
              "components/site/core/**",
              "components/site/data/**",
              "ui_kits/sent_ops/**",
              "ui_kits/website/**",
              "ui_kits/website/screens/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Space Grotesk|Space Mono|Cormorant Garamond|Cinzel|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Space Grotesk, Space Mono, Cormorant Garamond, Cinzel, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApiCallRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:call|style|key|ref|className|style|children)$/]",
        "message": "<ApiCallRow> doesn't accept that prop. Declared props: call, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandLockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|style|key|ref|className|style|children)$/]",
        "message": "<BrandLockup> doesn't accept that prop. Declared props: name, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|onClick|type|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, href, onClick, type, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|primary|dark)$/]",
        "message": "<Button> variant must be one of 'ghost' | 'primary' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|arrow|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<CardLink> doesn't accept that prop. Declared props: href, arrow, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CouncilUser'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|handle|initials|color|role|kind|joined|last|spec|contact|key|ref|className|style|children)$/]",
        "message": "<CouncilUser> doesn't accept that prop. Declared props: id, name, handle, initials, color, role, kind, joined, last, spec, contact."
      },
      {
        "selector": "JSXOpeningElement[name.name='CouncilUser'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:human|agent)$/]",
        "message": "<CouncilUser> kind must be one of 'human' | 'agent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|type|textarea|options|placeholder|wide|value|onChange|name|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, type, textarea, options, placeholder, wide, value, onChange, name."
