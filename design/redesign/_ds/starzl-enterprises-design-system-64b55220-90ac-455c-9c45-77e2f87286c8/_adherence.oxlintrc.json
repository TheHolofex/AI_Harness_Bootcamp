      {
        "selector": "JSXOpeningElement[name.name='KeyRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:apiKey|style|key|ref|className|style|children)$/]",
        "message": "<KeyRow> doesn't accept that prop. Declared props: apiKey, style."
